 155:src/controls.cpp **** // Initialize the hardware, let the ADC settle, then prime the filters with
 156:src/controls.cpp **** // real readings before publishing the first control snapshot.
 157:src/controls.cpp **** void Controls::Init(daisy::DaisySeed& hw, ControlMailbox& mailbox)
 158:src/controls.cpp **** {
 159:src/controls.cpp ****     mailbox_ = &mailbox;
 160:src/controls.cpp **** 
 161:src/controls.cpp ****     daisy::AdcChannelConfig adc_cfg[config::ADC_COUNT];
 162:src/controls.cpp ****     adc_cfg[config::ADC_POT_0].InitSingle(config::kPotPins[0]);
 163:src/controls.cpp ****     adc_cfg[config::ADC_POT_1].InitSingle(config::kPotPins[1]);
 164:src/controls.cpp ****     adc_cfg[config::ADC_POT_2].InitSingle(config::kPotPins[2]);
ARM GAS  C:\Users\aydan\AppData\Local\Temp\cc7urGjn.s 			page 29


 165:src/controls.cpp ****     adc_cfg[config::ADC_ROTARY].InitSingle(config::kRotaryPin);
 166:src/controls.cpp ****     hw.adc.Init(adc_cfg, config::ADC_COUNT);
 167:src/controls.cpp ****     hw.adc.Start();
 168:src/controls.cpp ****     hw.DelayMs(5);
 169:src/controls.cpp **** 
 170:src/controls.cpp ****     foot_.Init(config::kFootswitchPin, daisy::GPIO::Mode::INPUT, daisy::GPIO::Pull::PULLUP);
 171:src/controls.cpp ****     const bool rotary_ok = rotary_.Init(config::kRotaryCentersU16,
 172:src/controls.cpp ****                                         config::kRotaryPositionCount,
 173:src/controls.cpp ****                                         config::kRotaryHysteresisU16,
 174:src/controls.cpp ****                                         config::kRotaryMaxCenterErrorU16);
 175:src/controls.cpp **** 
 176:src/controls.cpp ****     float pot_accum[config::kPhysicalPotCount] = {0.0f, 0.0f, 0.0f};
 177:src/controls.cpp ****     float rotary_accum = 0.0f;
 178:src/controls.cpp ****     constexpr int kPrimeSamples = 8;
 179:src/controls.cpp ****     for(int sample = 0; sample < kPrimeSamples; ++sample)
 180:src/controls.cpp ****     {
 181:src/controls.cpp ****         for(int i = 0; i < config::kPhysicalPotCount; ++i)
 182:src/controls.cpp ****             pot_accum[i] += ClampFloat(hw.adc.GetFloat(i), 0.0f, 1.0f);
 183:src/controls.cpp ****         rotary_accum += ClampFloat(hw.adc.GetFloat(config::ADC_ROTARY), 0.0f, 1.0f);
 184:src/controls.cpp ****         hw.DelayMs(1);
 185:src/controls.cpp ****     }
 186:src/controls.cpp **** 
 187:src/controls.cpp ****     for(int i = 0; i < config::kPhysicalPotCount; ++i)
 188:src/controls.cpp ****     {
 189:src/controls.cpp ****         pot_filtered_[i] = pot_accum[i] / (float)kPrimeSamples;
 190:src/controls.cpp ****         pot_fixed_[i] = FloatToU16(pot_filtered_[i]);
 191:src/controls.cpp ****     }
 192:src/controls.cpp **** 
 193:src/controls.cpp ****     if(rotary_ok)
 194:src/controls.cpp ****     {
 195:src/controls.cpp ****         const uint16_t rotary_raw = FloatToU16(rotary_accum / (float)kPrimeSamples);
 196:src/controls.cpp ****         const uint32_t now = daisy::System::GetNow();
 197:src/controls.cpp ****         const int first = rotary_.Update(rotary_raw, now);
 198:src/controls.cpp ****         const int stable = rotary_.Update(rotary_raw, now + config::kRotaryDebounceMs);
 199:src/controls.cpp ****         uint8_t mapped_effect = requested_effect_;
 200:src/controls.cpp ****         if(RotaryPositionToEffect(stable != 0 ? stable : first, mapped_effect))
 201:src/controls.cpp ****             requested_effect_ = mapped_effect;
 202:src/controls.cpp ****     }
 203:src/controls.cpp **** 
 204:src/controls.cpp ****     initialized_ = true;
 205:src/controls.cpp ****     Publish();
 206:src/controls.cpp **** }
