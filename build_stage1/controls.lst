  21:src/controls.cpp ****     {
  22:src/controls.cpp ****         last_sample_ = sample;
  23:src/controls.cpp ****         last_change_ms_ = now_ms;
  24:src/controls.cpp ****     }
  25:src/controls.cpp **** 
