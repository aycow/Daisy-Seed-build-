  33:src/control_mailbox.h **** // Single-writer/single-reader mailbox for the main loop -> audio callback handoff.
  34:src/control_mailbox.h **** // The main loop is the only writer, and the audio interrupt is the only reader.
  35:src/control_mailbox.h **** class ControlMailbox
  36:src/control_mailbox.h **** {
  37:src/control_mailbox.h ****   public:
  38:src/control_mailbox.h ****     ControlMailbox();
  39:src/control_mailbox.h **** 
  40:src/control_mailbox.h ****     // Publish() is called from the main loop after controls have been filtered and
  41:src/control_mailbox.h ****     // debounced. It marks the sequence odd while the payload is being copied.
  42:src/control_mailbox.h ****     void Publish(const ControlSnapshot& snapshot);
  43:src/control_mailbox.h **** 
  44:src/control_mailbox.h ****     // Read() is called once at the beginning of an audio block. It returns false
  45:src/control_mailbox.h ****     // if publication is in progress, allowing the callback to keep its last valid
  46:src/control_mailbox.h ****     // snapshot without blocking.
  47:src/control_mailbox.h ****     bool Read(ControlSnapshot& out, uint32_t& out_revision) const;
  48:src/control_mailbox.h **** 
  49:src/control_mailbox.h ****   private:
  50:src/control_mailbox.h ****     uint32_t sequence_;
  51:src/control_mailbox.h ****     ControlSnapshot snapshot_;
  52:src/control_mailbox.h **** };
  53:src/control_mailbox.h **** 
  54:src/control_mailbox.h **** inline ControlMailbox::ControlMailbox()
  55:src/control_mailbox.h **** : sequence_(0),
  56:src/control_mailbox.h ****   snapshot_{config::FX_TUNER, 0, (uint8_t)SystemMode::Normal, 0, {0, 0, 0}}
  57:src/control_mailbox.h **** {
  58:src/control_mailbox.h **** }
  59:src/control_mailbox.h **** 
  60:src/control_mailbox.h **** // GCC atomics provide the compiler and CPU barriers needed for the callback to
  61:src/control_mailbox.h **** // reject in-progress or torn snapshots. The sequence is even when stable and odd
  62:src/control_mailbox.h **** // while the writer is updating the payload.
