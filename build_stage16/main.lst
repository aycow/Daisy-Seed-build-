  17:src/control_mailbox.h **** // Compact requested-control state crossing from the foreground loop into the
  18:src/control_mailbox.h **** // audio interrupt. Keep this trivially copyable and small so a seqlock retry is
  19:src/control_mailbox.h **** // cheap and no dynamic allocation or mutex is needed.
  20:src/control_mailbox.h **** struct ControlSnapshot
  21:src/control_mailbox.h **** {
