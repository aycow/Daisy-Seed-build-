 451:src/audio_engine.cpp **** // Advance the wet/dry ramp once per sample. When the ramp reaches zero or
 452:src/audio_engine.cpp **** // one, the engine either switches modes or returns to steady state.
 453:src/audio_engine.cpp **** void AudioEngine::StepTransition()
 454:src/audio_engine.cpp **** {
 455:src/audio_engine.cpp ****     if(transition_ == TRANSITION_FADING_OUT)
 456:src/audio_engine.cpp ****     {
 457:src/audio_engine.cpp ****         wet_gain_ -= wet_gain_step_;
 458:src/audio_engine.cpp ****         if(wet_gain_ <= 0.0f)
 459:src/audio_engine.cpp ****         {
 460:src/audio_engine.cpp ****             wet_gain_      = 0.0f;
 461:src/audio_engine.cpp ****             active_effect_ = pending_effect_;
 462:src/audio_engine.cpp ****             active_bypass_ = pending_bypass_;
 463:src/audio_engine.cpp ****             transition_
 464:src/audio_engine.cpp ****                 = (active_effect_ != config::FX_TUNER && !active_bypass_)
 465:src/audio_engine.cpp ****                       ? TRANSITION_FADING_IN
 466:src/audio_engine.cpp ****                       : TRANSITION_STEADY;
 467:src/audio_engine.cpp ****         }
 468:src/audio_engine.cpp ****     }
 469:src/audio_engine.cpp ****     else if(transition_ == TRANSITION_FADING_IN)
 470:src/audio_engine.cpp ****     {
 471:src/audio_engine.cpp ****         wet_gain_ += wet_gain_step_;
 472:src/audio_engine.cpp ****         if(wet_gain_ >= 1.0f)
 473:src/audio_engine.cpp ****         {
 474:src/audio_engine.cpp ****             wet_gain_   = 1.0f;
 475:src/audio_engine.cpp ****             transition_ = TRANSITION_STEADY;
 476:src/audio_engine.cpp ****         }
 477:src/audio_engine.cpp ****     }
 478:src/audio_engine.cpp **** }
