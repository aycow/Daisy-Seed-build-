  31:src/tuner.cpp **** // Refine the detected YIN period by fitting a parabola around the best sample.
  32:src/tuner.cpp **** static void ParabolicDelta(float y0, float y1, float y2, float& delta)
  33:src/tuner.cpp **** {
  34:src/tuner.cpp ****     const float denom = (2.0f * y1 - y0 - y2);
  35:src/tuner.cpp ****     if(fabsf(denom) < 1e-12f)
  36:src/tuner.cpp ****     {
  37:src/tuner.cpp ****         delta = 0.0f;
  38:src/tuner.cpp ****         return;
  39:src/tuner.cpp ****     }
  40:src/tuner.cpp ****     delta = 0.5f * (y0 - y2) / denom;
  41:src/tuner.cpp ****     delta = ClampFloat(delta, -0.5f, 0.5f);
  42:src/tuner.cpp **** }
