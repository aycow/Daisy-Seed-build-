 219:src/tuner.cpp **** // Convert Hz to note name and cents relative to equal temperament A4=440.
 220:src/tuner.cpp **** void TunerAnalyzer::FrequencyToNote(float freq_hz, char* out_note, size_t out_size, float& out_cent
 221:src/tuner.cpp **** {
 222:src/tuner.cpp ****     if(freq_hz <= 0.0f)
 223:src/tuner.cpp ****     {
 224:src/tuner.cpp ****         std::snprintf(out_note, out_size, "--");
 225:src/tuner.cpp ****         out_cents = 0.0f;
 226:src/tuner.cpp ****         return;
 227:src/tuner.cpp ****     }
 228:src/tuner.cpp **** 
 229:src/tuner.cpp ****     const float midi_f = 69.0f + 12.0f * std::log2(freq_hz / 440.0f);
 230:src/tuner.cpp ****     const int midi_n = (int)std::round(midi_f);
 231:src/tuner.cpp ****     static const char* names[12] = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"
 232:src/tuner.cpp ****     const int note_idx = ((midi_n % 12) + 12) % 12;
 233:src/tuner.cpp ****     const int octave = (midi_n / 12) - 1;
 234:src/tuner.cpp ****     std::snprintf(out_note, out_size, "%s%d", names[note_idx], octave);
 235:src/tuner.cpp ****     out_cents = (midi_f - (float)midi_n) * 100.0f;
 236:src/tuner.cpp **** }
