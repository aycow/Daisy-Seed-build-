  87:project006.cpp ****     for(int i = 0; i < kNumPos; i++)
  88:project006.cpp ****         if(!rot[i].Read())
  89:project006.cpp ****             return i + 1; // 1..6
  90:project006.cpp ****     return 0; // can happen briefly while rotating
  91:project006.cpp **** }
  92:project006.cpp **** 
  93:project006.cpp **** static bool RotaryPosToFx(int pos, int& out_fx)
  94:project006.cpp **** {
  95:project006.cpp ****     // Use only positions 1..4 => FX 0..3
  96:project006.cpp ****     if(pos >= 1 && pos <= 4)
  97:project006.cpp ****     {
  98:project006.cpp ****         out_fx = pos - 1;
  99:project006.cpp ****         return true;
 100:project006.cpp ****     }
 101:project006.cpp ****     return false;
 102:project006.cpp **** }
