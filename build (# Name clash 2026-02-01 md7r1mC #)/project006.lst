  69:project006.cpp **** static inline float clampf(float x, float lo, float hi)
  70:project006.cpp **** {
  71:project006.cpp ****     return (x < lo) ? lo : (x > hi) ? hi : x;
  72:project006.cpp **** }
  73:project006.cpp **** 
  74:project006.cpp **** static inline float softclip(float x)
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccPU8E4p.s 			page 15


  75:project006.cpp **** {
  76:project006.cpp ****     // simple, cheap soft-ish clip
