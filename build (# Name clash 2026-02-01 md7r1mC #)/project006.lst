 391:project006.cpp ****     bool     last_sample    = true;
 392:project006.cpp ****     uint32_t last_change_ms = 0;
 393:project006.cpp **** 
 394:project006.cpp ****     bool Update(bool sample, uint32_t now_ms, uint32_t debounce_ms)
 395:project006.cpp ****     {
 396:project006.cpp ****         if(sample != last_sample)
 397:project006.cpp ****         {
 398:project006.cpp ****             last_sample    = sample;
 399:project006.cpp ****             last_change_ms = now_ms;
 400:project006.cpp ****         }
 401:project006.cpp ****         if(sample != stable && (now_ms - last_change_ms) >= debounce_ms)
 402:project006.cpp ****         {
 403:project006.cpp ****             stable = sample;
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccPU8E4p.s 			page 49


 404:project006.cpp ****             return true;
 405:project006.cpp ****         }
 406:project006.cpp ****         return false;
 407:project006.cpp ****     }
 408:project006.cpp **** };
