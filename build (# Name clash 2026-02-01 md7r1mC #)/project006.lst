 335:project006.cpp ****             y = x; // pass-through
 336:project006.cpp ****         }
 337:project006.cpp ****         else if(fx == FX_CHORUS)
 338:project006.cpp ****         {
 339:project006.cpp ****             if(bypass)
 340:project006.cpp ****             {
 341:project006.cpp ****                 y = x;
 342:project006.cpp ****             }
 343:project006.cpp ****             else
 344:project006.cpp ****             {
