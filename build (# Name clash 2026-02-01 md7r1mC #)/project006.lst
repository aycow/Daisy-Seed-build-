 149:project006.cpp **** struct PitchResult
 150:project006.cpp **** {
 151:project006.cpp ****     bool  valid   = false;
 152:project006.cpp ****     float freq_hz = 110.0f;
 153:project006.cpp ****     float conf    = 0.0f;
 154:project006.cpp ****     float cents   = 0.0f;
 155:project006.cpp ****     char  note[8] = "A2";
 156:project006.cpp **** };
 157:project006.cpp **** 
 158:project006.cpp **** static void freq_to_note(float freq, char* out_note, size_t out_sz, float& out_cents)
 159:project006.cpp **** {
 160:project006.cpp ****     if(freq <= 0.0f)
 161:project006.cpp ****     {
 162:project006.cpp ****         std::snprintf(out_note, out_sz, "A2");
 163:project006.cpp ****         out_cents = 0.0f;
 164:project006.cpp ****         return;
 165:project006.cpp ****     }
 166:project006.cpp ****     float midi_f = 69.0f + 12.0f * (std::log2(freq / 440.0f));
 167:project006.cpp ****     int   midi_n = (int)std::round(midi_f);
 168:project006.cpp **** 
 169:project006.cpp ****     static const char* names[12] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};
 170:project006.cpp **** 
 171:project006.cpp ****     int note_idx = ((midi_n % 12) + 12) % 12;
 172:project006.cpp ****     int octave   = (midi_n / 12) - 1;
 173:project006.cpp **** 
 174:project006.cpp ****     std::snprintf(out_note, out_sz, "%s%d", names[note_idx], octave);
 175:project006.cpp ****     out_cents = (midi_f - (float)midi_n) * 100.0f;
 176:project006.cpp **** }
 177:project006.cpp **** 
 178:project006.cpp **** // Simple AMDF pitch estimate on downsampled window.
 179:project006.cpp **** static PitchResult estimate_pitch(const float* x, int n, float fs,
 180:project006.cpp ****                                   float sens_norm, float smooth_norm,
 181:project006.cpp ****                                   float& freq_smoother)
 182:project006.cpp **** {
 183:project006.cpp ****     PitchResult pr;
 184:project006.cpp **** 
 185:project006.cpp ****     // Remove DC + compute RMS
 186:project006.cpp ****     float mean = 0.0f;
 187:project006.cpp ****     for(int i = 0; i < n; i++) mean += x[i];
 188:project006.cpp ****     mean /= (float)n;
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccPU8E4p.s 			page 17


 189:project006.cpp **** 
 190:project006.cpp ****     float e = 0.0f;
 191:project006.cpp ****     static float xd[1024];
 192:project006.cpp ****     for(int i = 0; i < n; i++)
 193:project006.cpp ****     {
 194:project006.cpp ****         xd[i] = x[i] - mean;
 195:project006.cpp ****         e += xd[i] * xd[i];
 196:project006.cpp ****     }
 197:project006.cpp ****     float rms = std::sqrt(e / (float)n);
 198:project006.cpp ****     if(rms < 0.01f)
 199:project006.cpp ****         return pr;
 200:project006.cpp **** 
 201:project006.cpp ****     // Downsample by 4 -> 256 samples
 202:project006.cpp ****     static float ds[256];
 203:project006.cpp ****     int dn = 0;
 204:project006.cpp ****     for(int i = 0; i < n; i += 4)
 205:project006.cpp ****         ds[dn++] = xd[i];
 206:project006.cpp **** 
 207:project006.cpp ****     float fs_ds = fs / 4.0f;
 208:project006.cpp **** 
 209:project006.cpp ****     // Lag range (guitar-ish): 70..1000 Hz
 210:project006.cpp ****     int minLag = (int)(fs_ds / 1000.0f);
 211:project006.cpp ****     int maxLag = (int)(fs_ds / 70.0f);
 212:project006.cpp ****     if(maxLag >= dn - 1) maxLag = dn - 2;
 213:project006.cpp ****     if(minLag < 2) minLag = 2;
 214:project006.cpp **** 
 215:project006.cpp ****     float best   = 1e30f;
 216:project006.cpp ****     int   bestLag = -1;
 217:project006.cpp ****     float avg    = 0.0f;
 218:project006.cpp ****     int   count  = 0;
 219:project006.cpp **** 
 220:project006.cpp ****     for(int lag = minLag; lag <= maxLag; lag++)
 221:project006.cpp ****     {
 222:project006.cpp ****         float s = 0.0f;
 223:project006.cpp ****         for(int i = 0; i < dn - lag; i++)
 224:project006.cpp ****             s += std::fabs(ds[i] - ds[i + lag]);
 225:project006.cpp **** 
 226:project006.cpp ****         avg += s;
 227:project006.cpp ****         count++;
 228:project006.cpp **** 
 229:project006.cpp ****         if(s < best)
 230:project006.cpp ****         {
 231:project006.cpp ****             best    = s;
 232:project006.cpp ****             bestLag = lag;
 233:project006.cpp ****         }
 234:project006.cpp ****     }
 235:project006.cpp ****     if(bestLag < 0) return pr;
 236:project006.cpp **** 
 237:project006.cpp ****     avg /= (float)count;
 238:project006.cpp ****     float conf = 1.0f - (best / (avg + 1e-9f));
 239:project006.cpp ****     conf = clampf(conf, 0.0f, 1.0f);
 240:project006.cpp **** 
 241:project006.cpp ****     // Sens pot: required confidence ~0.45..0.75
 242:project006.cpp ****     float conf_req = 0.45f + 0.30f * sens_norm;
 243:project006.cpp **** 
 244:project006.cpp ****     float freq = fs_ds / (float)bestLag;
 245:project006.cpp **** 
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccPU8E4p.s 			page 18


 246:project006.cpp ****     // Smooth pot: higher = more smoothing (slower)
 247:project006.cpp ****     float alpha_fast = 0.25f;
 248:project006.cpp ****     float alpha_slow = 0.03f;
 249:project006.cpp ****     float alpha = alpha_fast + (alpha_slow - alpha_fast) * smooth_norm;
 250:project006.cpp **** 
 251:project006.cpp ****     freq_smoother = freq_smoother + alpha * (freq - freq_smoother);
 252:project006.cpp ****     float freq_sm = freq_smoother;
 253:project006.cpp **** 
 254:project006.cpp ****     float cents = 0.0f;
 255:project006.cpp ****     char  note[8];
 256:project006.cpp ****     freq_to_note(freq_sm, note, sizeof(note), cents);
 257:project006.cpp **** 
 258:project006.cpp ****     pr.valid   = (conf >= conf_req) && (freq_sm >= 70.0f) && (freq_sm <= 1000.0f);
 259:project006.cpp ****     pr.freq_hz = freq_sm;
 260:project006.cpp ****     pr.conf    = conf;
 261:project006.cpp ****     pr.cents   = cents;
 262:project006.cpp ****     std::snprintf(pr.note, sizeof(pr.note), "%s", note);
 263:project006.cpp ****     return pr;
 264:project006.cpp **** }
