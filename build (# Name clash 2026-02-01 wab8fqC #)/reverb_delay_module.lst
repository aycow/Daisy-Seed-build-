  77:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp **** void ReverbDelayModule::UpdateLEDRate()
  78:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp **** {
  79:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     // Update the LED oscillator frequency based on the current timeParam
  80:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float timeParam = GetParameterAsMagnitude(0);
  81:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float delaySamples = m_delaySamplesMin + (m_delaySamplesMax - m_delaySamplesMin) * timeParam;
