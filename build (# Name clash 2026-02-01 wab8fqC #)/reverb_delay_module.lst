  87:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp **** {
  88:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     // Handle Normal or Alternate Mode Mix Controls
  89:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     //    A computationally cheap mostly energy constant crossfade from SignalSmith Blog
  90:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     //    https://signalsmith-audio.co.uk/writing/2021/cheap-energy-crossfade/
  91:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp **** 
  92:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float delMixKnob = GetParameterAsMagnitude(2);
  93:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float x2 = 1.0 - delMixKnob;
  94:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float A = delMixKnob*x2;
  95:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float B = A * (1.0 + 1.4186 * A);
  96:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float C = B + delMixKnob;
  97:gml/GuitarPedal/Effect-Modules/reverb_delay_module.cpp ****     float D = B + x2;
