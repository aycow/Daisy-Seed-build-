 109:project006.cpp **** static inline bool str_contains_ci(const char *hay, const char *needle)
 110:project006.cpp **** {
 111:project006.cpp ****     if(!hay || !needle)
 112:project006.cpp ****         return false;
 113:project006.cpp ****     // very small, simple case-insensitive substring check
 114:project006.cpp ****     for(const char *h = hay; *h; ++h)
 115:project006.cpp ****     {
 116:project006.cpp ****         const char *h2 = h;
 117:project006.cpp ****         const char *n  = needle;
 118:project006.cpp ****         while(*h2 && *n)
 119:project006.cpp ****         {
 120:project006.cpp ****             char ch = *h2;
 121:project006.cpp ****             char cn = *n;
 122:project006.cpp ****             if(ch >= 'A' && ch <= 'Z')
 123:project006.cpp ****                 ch = char(ch - 'A' + 'a');
 124:project006.cpp ****             if(cn >= 'A' && cn <= 'Z')
 125:project006.cpp ****                 cn = char(cn - 'A' + 'a');
 126:project006.cpp ****             if(ch != cn)
 127:project006.cpp ****                 break;
 128:project006.cpp ****             ++h2;
 129:project006.cpp ****             ++n;
ARM GAS  C:\Users\aydan\AppData\Local\Temp\cc21BorY.s 			page 11


 130:project006.cpp ****         }
 131:project006.cpp ****         if(*n == '\0')
 132:project006.cpp ****             return true;
 133:project006.cpp ****     }
 134:project006.cpp ****     return false;
 135:project006.cpp **** }
