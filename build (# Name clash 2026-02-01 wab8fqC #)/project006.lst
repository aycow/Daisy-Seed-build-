 191:project006.cpp **** struct PitchResult
 192:project006.cpp **** {
 193:project006.cpp ****     bool  valid   = false;
 194:project006.cpp ****     float freq_hz = 110.0f;
 195:project006.cpp ****     float conf    = 0.0f;
 196:project006.cpp ****     float cents   = 0.0f;
 197:project006.cpp ****     char  note[8] = "A2";
 198:project006.cpp **** };
 199:project006.cpp **** 
 200:project006.cpp **** static void freq_to_note(float freq, char *out_note, size_t out_sz, float &out_cents)
 201:project006.cpp **** {
 202:project006.cpp ****     if(freq <= 0.0f)
 203:project006.cpp ****     {
 204:project006.cpp ****         std::snprintf(out_note, out_sz, "A2");
 205:project006.cpp ****         out_cents = 0.0f;
 206:project006.cpp ****         return;
 207:project006.cpp ****     }
 208:project006.cpp ****     float midi_f = 69.0f + 12.0f * (std::log2(freq / 440.0f));
 209:project006.cpp ****     int   midi_n = (int)std::round(midi_f);
 210:project006.cpp **** 
 211:project006.cpp ****     static const char *names[12] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};
 212:project006.cpp ****     int note_idx = ((midi_n % 12) + 12) % 12;
 213:project006.cpp ****     int octave   = (midi_n / 12) - 1;
 214:project006.cpp **** 
 215:project006.cpp ****     std::snprintf(out_note, out_sz, "%s%d", names[note_idx], octave);
 216:project006.cpp ****     out_cents = (midi_f - (float)midi_n) * 100.0f;
 217:project006.cpp **** }
 218:project006.cpp **** 
 219:project006.cpp **** static PitchResult estimate_pitch(const float *x, int n, float fs,
 220:project006.cpp ****                                   float sens_norm, float smooth_norm,
 221:project006.cpp ****                                   float &freq_smoother)
 222:project006.cpp **** {
 223:project006.cpp ****     PitchResult pr;
 224:project006.cpp **** 
 225:project006.cpp ****     // DC remove + RMS
 226:project006.cpp ****     float mean = 0.0f;
 227:project006.cpp ****     for(int i = 0; i < n; i++)
 228:project006.cpp ****         mean += x[i];
 229:project006.cpp ****     mean /= (float)n;
 230:project006.cpp **** 
 231:project006.cpp ****     float e = 0.0f;
 232:project006.cpp ****     static float xd[1024];
 233:project006.cpp ****     for(int i = 0; i < n; i++)
 234:project006.cpp ****     {
 235:project006.cpp ****         xd[i] = x[i] - mean;
 236:project006.cpp ****         e += xd[i] * xd[i];
 237:project006.cpp ****     }
 238:project006.cpp ****     float rms = std::sqrt(e / (float)n);
 239:project006.cpp ****     if(rms < 0.01f)
 240:project006.cpp ****         return pr;
 241:project006.cpp **** 
 242:project006.cpp ****     // Downsample by 4
 243:project006.cpp ****     static float ds[256];
ARM GAS  C:\Users\aydan\AppData\Local\Temp\cc21BorY.s 			page 13


 244:project006.cpp ****     int dn = 0;
 245:project006.cpp ****     for(int i = 0; i < n; i += 4)
 246:project006.cpp ****         ds[dn++] = xd[i];
 247:project006.cpp ****     float fs_ds = fs / 4.0f;
 248:project006.cpp **** 
 249:project006.cpp ****     // Lag range ~ 70..1000Hz
 250:project006.cpp ****     int minLag = (int)(fs_ds / 1000.0f);
 251:project006.cpp ****     int maxLag = (int)(fs_ds / 70.0f);
 252:project006.cpp ****     if(maxLag >= dn - 1) maxLag = dn - 2;
 253:project006.cpp ****     if(minLag < 2) minLag = 2;
 254:project006.cpp **** 
 255:project006.cpp ****     float best    = 1e30f;
 256:project006.cpp ****     int   bestLag = -1;
 257:project006.cpp ****     float avg     = 0.0f;
 258:project006.cpp ****     int   count   = 0;
 259:project006.cpp **** 
 260:project006.cpp ****     for(int lag = minLag; lag <= maxLag; lag++)
 261:project006.cpp ****     {
 262:project006.cpp ****         float s = 0.0f;
 263:project006.cpp ****         for(int i = 0; i < dn - lag; i++)
 264:project006.cpp ****             s += std::fabs(ds[i] - ds[i + lag]);
 265:project006.cpp **** 
 266:project006.cpp ****         avg += s;
 267:project006.cpp ****         count++;
 268:project006.cpp **** 
 269:project006.cpp ****         if(s < best)
 270:project006.cpp ****         {
 271:project006.cpp ****             best    = s;
 272:project006.cpp ****             bestLag = lag;
 273:project006.cpp ****         }
 274:project006.cpp ****     }
 275:project006.cpp ****     if(bestLag < 0)
 276:project006.cpp ****         return pr;
 277:project006.cpp **** 
 278:project006.cpp ****     avg /= (float)count;
 279:project006.cpp ****     float conf = 1.0f - (best / (avg + 1e-9f));
 280:project006.cpp ****     conf = clampf(conf, 0.0f, 1.0f);
 281:project006.cpp **** 
 282:project006.cpp ****     float conf_req = 0.45f + 0.30f * sens_norm;
 283:project006.cpp ****     float freq     = fs_ds / (float)bestLag;
 284:project006.cpp **** 
 285:project006.cpp ****     float alpha_fast = 0.25f;
 286:project006.cpp ****     float alpha_slow = 0.03f;
