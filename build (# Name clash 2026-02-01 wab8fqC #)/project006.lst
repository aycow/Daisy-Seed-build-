 307:project006.cpp **** ChorusModule      fx_chorus;
 308:project006.cpp **** ReverbDelayModule fx_revdel;
 309:project006.cpp **** OverdriveModule   fx_od;
 310:project006.cpp **** 
 311:project006.cpp **** BaseEffectModule *fx_modules[FX_COUNT] = {
 312:project006.cpp ****     nullptr,      // FX_TUNER (not a module)
 313:project006.cpp ****     &fx_chorus,   // FX_CHORUS
 314:project006.cpp ****     &fx_revdel,   // FX_REVERBDELAY
 315:project006.cpp ****     &fx_od        // FX_OVERDRIVE
 316:project006.cpp **** };
 317:project006.cpp **** 
 318:project006.cpp **** // For each effect, store which parameter IDs we’ll drive from the 3 pots
 319:project006.cpp **** struct PotParamMap
 320:project006.cpp **** {
 321:project006.cpp ****     int p0 = -1;
 322:project006.cpp ****     int p1 = -1;
 323:project006.cpp ****     int p2 = -1;
 324:project006.cpp **** };
 325:project006.cpp **** 
 326:project006.cpp **** PotParamMap map_chorus;
 327:project006.cpp **** PotParamMap map_revdel;
 328:project006.cpp **** PotParamMap map_od;
 329:project006.cpp **** 
 330:project006.cpp **** static int find_param_by_keywords(BaseEffectModule *fx,
 331:project006.cpp ****                                   const char *kw1,
 332:project006.cpp ****                                   const char *kw2 = nullptr,
 333:project006.cpp ****                                   const char *kw3 = nullptr)
 334:project006.cpp **** {
 335:project006.cpp ****     if(!fx)
 336:project006.cpp ****         return -1;
 337:project006.cpp ****     const int n = (int)fx->GetParameterCount();
 338:project006.cpp ****     for(int i = 0; i < n; i++)
 339:project006.cpp ****     {
 340:project006.cpp ****         const char *name = fx->GetParameterName(i);
 341:project006.cpp ****         if(str_contains_ci(name, kw1)
 342:project006.cpp ****            || (kw2 && str_contains_ci(name, kw2))
 343:project006.cpp ****            || (kw3 && str_contains_ci(name, kw3)))
 344:project006.cpp ****         {
 345:project006.cpp ****             return i;
 346:project006.cpp ****         }
 347:project006.cpp ****     }
 348:project006.cpp ****     return -1;
 349:project006.cpp **** }
 350:project006.cpp **** 
 351:project006.cpp **** static int fallback_param_for_pot(BaseEffectModule *fx, int pot_idx)
 352:project006.cpp **** {
 353:project006.cpp ****     if(!fx)
 354:project006.cpp ****         return -1;
 355:project006.cpp ****     // Try knob mapping first (if their metadata used it)
 356:project006.cpp ****     int pid = fx->GetMappedParameterIDForKnob(pot_idx);
 357:project006.cpp ****     if(pid >= 0)
ARM GAS  C:\Users\aydan\AppData\Local\Temp\cc21BorY.s 			page 15


 358:project006.cpp ****         return pid;
 359:project006.cpp **** 
 360:project006.cpp ****     // Otherwise, just use first parameters
 361:project006.cpp ****     int n = (int)fx->GetParameterCount();
 362:project006.cpp ****     if(pot_idx < n)
 363:project006.cpp ****         return pot_idx;
 364:project006.cpp ****     return -1;
 365:project006.cpp **** }
 366:project006.cpp **** 
 367:project006.cpp **** static void build_param_maps()
 368:project006.cpp **** {
 369:project006.cpp ****     // Chorus: mix / rate / depth
 370:project006.cpp ****     map_chorus.p0 = find_param_by_keywords(&fx_chorus, "mix", "wet");
 371:project006.cpp ****     map_chorus.p1 = find_param_by_keywords(&fx_chorus, "rate", "speed", "freq");
 372:project006.cpp ****     map_chorus.p2 = find_param_by_keywords(&fx_chorus, "depth");
 373:project006.cpp **** 
 374:project006.cpp ****     if(map_chorus.p0 < 0) map_chorus.p0 = fallback_param_for_pot(&fx_chorus, 0);
 375:project006.cpp ****     if(map_chorus.p1 < 0) map_chorus.p1 = fallback_param_for_pot(&fx_chorus, 1);
 376:project006.cpp ****     if(map_chorus.p2 < 0) map_chorus.p2 = fallback_param_for_pot(&fx_chorus, 2);
 377:project006.cpp **** 
 378:project006.cpp ****     // Reverb/Delay: mix / time(or decay) / feedback(or regen)
 379:project006.cpp ****     map_revdel.p0 = find_param_by_keywords(&fx_revdel, "mix", "wet");
 380:project006.cpp ****     map_revdel.p1 = find_param_by_keywords(&fx_revdel, "time", "delay", "decay");
 381:project006.cpp ****     map_revdel.p2 = find_param_by_keywords(&fx_revdel, "feedback", "regen", "fb");
 382:project006.cpp **** 
 383:project006.cpp ****     if(map_revdel.p0 < 0) map_revdel.p0 = fallback_param_for_pot(&fx_revdel, 0);
 384:project006.cpp ****     if(map_revdel.p1 < 0) map_revdel.p1 = fallback_param_for_pot(&fx_revdel, 1);
 385:project006.cpp ****     if(map_revdel.p2 < 0) map_revdel.p2 = fallback_param_for_pot(&fx_revdel, 2);
 386:project006.cpp **** 
 387:project006.cpp ****     // Overdrive: drive / tone / mix(or level)
 388:project006.cpp ****     map_od.p0 = find_param_by_keywords(&fx_od, "drive", "gain");
 389:project006.cpp ****     map_od.p1 = find_param_by_keywords(&fx_od, "tone", "filter");
 390:project006.cpp ****     map_od.p2 = find_param_by_keywords(&fx_od, "mix", "level", "vol");
 391:project006.cpp **** 
 392:project006.cpp ****     if(map_od.p0 < 0) map_od.p0 = fallback_param_for_pot(&fx_od, 0);
 393:project006.cpp ****     if(map_od.p1 < 0) map_od.p1 = fallback_param_for_pot(&fx_od, 1);
 394:project006.cpp ****     if(map_od.p2 < 0) map_od.p2 = fallback_param_for_pot(&fx_od, 2);
 395:project006.cpp **** }
 396:project006.cpp **** 
 397:project006.cpp **** static void apply_pots_to_fx(int fx_id, float p0, float p1, float p2)
 398:project006.cpp **** {
 399:project006.cpp ****     BaseEffectModule *fx = fx_modules[fx_id];
 400:project006.cpp ****     if(!fx)
 401:project006.cpp ****         return;
 402:project006.cpp **** 
 403:project006.cpp ****     const float a0 = clampf(p0, 0.f, 1.f);
 404:project006.cpp ****     const float a1 = clampf(p1, 0.f, 1.f);
 405:project006.cpp ****     const float a2 = clampf(p2, 0.f, 1.f);
 406:project006.cpp **** 
 407:project006.cpp ****     PotParamMap m;
 408:project006.cpp ****     if(fx_id == FX_CHORUS)      m = map_chorus;
 409:project006.cpp ****     else if(fx_id == FX_REVERBDELAY) m = map_revdel;
 410:project006.cpp ****     else if(fx_id == FX_OVERDRIVE)   m = map_od;
 411:project006.cpp ****     else return;
 412:project006.cpp **** 
 413:project006.cpp ****     if(m.p0 >= 0) fx->SetParameterAsMagnitude(m.p0, a0);
 414:project006.cpp ****     if(m.p1 >= 0) fx->SetParameterAsMagnitude(m.p1, a1);
ARM GAS  C:\Users\aydan\AppData\Local\Temp\cc21BorY.s 			page 16


 415:project006.cpp ****     if(m.p2 >= 0) fx->SetParameterAsMagnitude(m.p2, a2);
 416:project006.cpp **** }
