  99:project006.cpp **** static inline float clampf(float x, float lo, float hi)
 100:project006.cpp **** {
 101:project006.cpp ****     return (x < lo) ? lo : (x > hi) ? hi : x;
 102:project006.cpp **** }
 103:project006.cpp **** 
 104:project006.cpp **** static inline float lpf1(float y, float x, float a)
 105:project006.cpp **** {
 106:project006.cpp ****     return y + a * (x - y);
 107:project006.cpp **** }
