 159:project006.cpp **** struct Debounce1
 160:project006.cpp **** {
 161:project006.cpp ****     bool     stable         = true; // pull-up: true=UP, false=DOWN
 162:project006.cpp ****     bool     last_sample    = true;
 163:project006.cpp ****     uint32_t last_change_ms = 0;
 164:project006.cpp **** 
 165:project006.cpp ****     bool Update(bool sample, uint32_t now_ms, uint32_t debounce_ms)
 166:project006.cpp ****     {
 167:project006.cpp ****         if(sample != last_sample)
 168:project006.cpp ****         {
 169:project006.cpp ****             last_sample    = sample;
 170:project006.cpp ****             last_change_ms = now_ms;
 171:project006.cpp ****         }
 172:project006.cpp ****         if(sample != stable && (now_ms - last_change_ms) >= debounce_ms)
 173:project006.cpp ****         {
 174:project006.cpp ****             stable = sample;
 175:project006.cpp ****             return true;
 176:project006.cpp ****         }
 177:project006.cpp ****         return false;
 178:project006.cpp ****     }
 179:project006.cpp **** };
