 112:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** // This module is processed only from the audio callback, one sample at a time.
 113:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** // It reads the cached parameters above and writes the current wet output here.
 114:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** void GranularDelayModule::ProcessMono(float in)
 115:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** {
 116:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     BaseEffectModule::ProcessMono(in);
 117:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** 
 118:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     if(!loop_recorded_)
 119:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     {
 120:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         if(first_count_ == 0)
 121:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****             looper_.TrigRecord();
 122:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         if(first_count_ > kMaxSamples)
 123:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         {
 124:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****             loop_recorded_ = true;
 125:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****             looper_.TrigRecord();
 126:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         }
 127:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         else
 128:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         {
 129:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****             ++first_count_;
 130:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         }
 131:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     }
 132:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** 
 133:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     if(!hold_)
 134:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****         looper_.Process(in);
 135:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** 
 136:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     current_grain_size_ms_ += 0.0001f * (size_ms_ - current_grain_size_ms_);
 137:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     granular_.Process(speed_, pitch_cents_, current_grain_size_ms_, width_ms_);
 138:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp **** 
 139:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     const float gran_left = granular_.getLeftOut();
 140:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     const float gran_right = granular_.getRightOut();
 141:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     m_audioLeft = gran_left * mix_ + in * (1.0f - mix_);
 142:gml/GuitarPedal/Effect-Modules/granulardelay_module.cpp ****     m_audioRight = gran_right * mix_ + in * (1.0f - mix_);
