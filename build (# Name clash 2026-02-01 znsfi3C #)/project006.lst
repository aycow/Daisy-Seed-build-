  99:project006.cpp **** static inline float clampf(float x, float lo, float hi)
 100:project006.cpp **** {
 101:project006.cpp ****     return (x < lo) ? lo : (x > hi) ? hi : x;
 102:project006.cpp **** }
 103:project006.cpp **** 
 104:project006.cpp **** static inline float softclip(float x)
 105:project006.cpp **** {
 106:project006.cpp ****     // cheap soft-ish clip
 107:project006.cpp ****     x = clampf(x, -2.0f, 2.0f);
 108:project006.cpp ****     return x / (1.0f + std::fabs(x));
 109:project006.cpp **** }
