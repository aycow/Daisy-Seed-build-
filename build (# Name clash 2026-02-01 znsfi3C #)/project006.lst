 142:project006.cpp **** struct PitchResult
 143:project006.cpp **** {
 144:project006.cpp ****     bool  valid   = false;
 145:project006.cpp ****     float freq_hz = 110.0f;
 146:project006.cpp ****     float conf    = 0.0f;
 147:project006.cpp ****     float cents   = 0.0f;
 148:project006.cpp ****     char  note[8] = "A2";
 149:project006.cpp **** };
 150:project006.cpp **** 
 151:project006.cpp **** static void freq_to_note(float freq, char* out_note, size_t out_sz, float& out_cents)
 152:project006.cpp **** {
 153:project006.cpp ****     if(freq <= 0.0f)
 154:project006.cpp ****     {
 155:project006.cpp ****         std::snprintf(out_note, out_sz, "A2");
 156:project006.cpp ****         out_cents = 0.0f;
 157:project006.cpp ****         return;
 158:project006.cpp ****     }
 159:project006.cpp ****     float midi_f = 69.0f + 12.0f * (std::log2(freq / 440.0f));
 160:project006.cpp ****     int   midi_n = (int)std::round(midi_f);
 161:project006.cpp **** 
 162:project006.cpp ****     static const char* names[12] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};
 163:project006.cpp **** 
 164:project006.cpp ****     int note_idx = ((midi_n % 12) + 12) % 12;
 165:project006.cpp ****     int octave   = (midi_n / 12) - 1;
 166:project006.cpp **** 
 167:project006.cpp ****     std::snprintf(out_note, out_sz, "%s%d", names[note_idx], octave);
 168:project006.cpp ****     out_cents = (midi_f - (float)midi_n) * 100.0f;
 169:project006.cpp **** }
 170:project006.cpp **** 
 171:project006.cpp **** // Simple AMDF pitch estimate on downsampled window.
 172:project006.cpp **** static PitchResult estimate_pitch(const float* x, int n, float fs,
 173:project006.cpp ****                                   float sens_norm, float smooth_norm,
 174:project006.cpp ****                                   float& freq_smoother)
 175:project006.cpp **** {
 176:project006.cpp ****     PitchResult pr;
 177:project006.cpp **** 
 178:project006.cpp ****     // Remove DC + compute RMS
 179:project006.cpp ****     float mean = 0.0f;
 180:project006.cpp ****     for(int i = 0; i < n; i++) mean += x[i];
 181:project006.cpp ****     mean /= (float)n;
 182:project006.cpp **** 
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccFsimCz.s 			page 15


 183:project006.cpp ****     float e = 0.0f;
 184:project006.cpp ****     static float xd[1024];
 185:project006.cpp ****     for(int i = 0; i < n; i++)
 186:project006.cpp ****     {
 187:project006.cpp ****         xd[i] = x[i] - mean;
 188:project006.cpp ****         e += xd[i] * xd[i];
 189:project006.cpp ****     }
 190:project006.cpp ****     float rms = std::sqrt(e / (float)n);
 191:project006.cpp ****     if(rms < 0.01f)
 192:project006.cpp ****         return pr;
 193:project006.cpp **** 
 194:project006.cpp ****     // Downsample by 4 -> 256 samples
 195:project006.cpp ****     static float ds[256];
 196:project006.cpp ****     int dn = 0;
 197:project006.cpp ****     for(int i = 0; i < n; i += 4)
 198:project006.cpp ****         ds[dn++] = xd[i];
 199:project006.cpp **** 
 200:project006.cpp ****     float fs_ds = fs / 4.0f;
 201:project006.cpp **** 
 202:project006.cpp ****     // Lag range (guitar-ish): 70..1000 Hz
 203:project006.cpp ****     int minLag = (int)(fs_ds / 1000.0f);
 204:project006.cpp ****     int maxLag = (int)(fs_ds / 70.0f);
 205:project006.cpp ****     if(maxLag >= dn - 1) maxLag = dn - 2;
 206:project006.cpp ****     if(minLag < 2) minLag = 2;
 207:project006.cpp **** 
 208:project006.cpp ****     float best    = 1e30f;
 209:project006.cpp ****     int   bestLag = -1;
 210:project006.cpp ****     float avg     = 0.0f;
 211:project006.cpp ****     int   count   = 0;
 212:project006.cpp **** 
 213:project006.cpp ****     for(int lag = minLag; lag <= maxLag; lag++)
 214:project006.cpp ****     {
 215:project006.cpp ****         float s = 0.0f;
 216:project006.cpp ****         for(int i = 0; i < dn - lag; i++)
 217:project006.cpp ****             s += std::fabs(ds[i] - ds[i + lag]);
 218:project006.cpp **** 
 219:project006.cpp ****         avg += s;
 220:project006.cpp ****         count++;
 221:project006.cpp **** 
 222:project006.cpp ****         if(s < best)
 223:project006.cpp ****         {
 224:project006.cpp ****             best    = s;
 225:project006.cpp ****             bestLag = lag;
 226:project006.cpp ****         }
 227:project006.cpp ****     }
 228:project006.cpp ****     if(bestLag < 0) return pr;
 229:project006.cpp **** 
 230:project006.cpp ****     avg /= (float)count;
 231:project006.cpp ****     float conf = 1.0f - (best / (avg + 1e-9f));
 232:project006.cpp ****     conf = clampf(conf, 0.0f, 1.0f);
 233:project006.cpp **** 
 234:project006.cpp ****     // Sens pot: required confidence ~0.45..0.75
 235:project006.cpp ****     float conf_req = 0.45f + 0.30f * sens_norm;
 236:project006.cpp **** 
 237:project006.cpp ****     float freq = fs_ds / (float)bestLag;
 238:project006.cpp **** 
 239:project006.cpp ****     // Smooth pot: higher = more smoothing (slower)
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccFsimCz.s 			page 16


 240:project006.cpp ****     float alpha_fast = 0.25f;
 241:project006.cpp ****     float alpha_slow = 0.03f;
 242:project006.cpp ****     float alpha = alpha_fast + (alpha_slow - alpha_fast) * smooth_norm;
 243:project006.cpp **** 
 244:project006.cpp ****     freq_smoother = freq_smoother + alpha * (freq - freq_smoother);
 245:project006.cpp ****     float freq_sm = freq_smoother;
 246:project006.cpp **** 
 247:project006.cpp ****     float cents = 0.0f;
 248:project006.cpp ****     char  note[8];
 249:project006.cpp ****     freq_to_note(freq_sm, note, sizeof(note), cents);
 250:project006.cpp **** 
 251:project006.cpp ****     pr.valid   = (conf >= conf_req) && (freq_sm >= 70.0f) && (freq_sm <= 1000.0f);
 252:project006.cpp ****     pr.freq_hz = freq_sm;
 253:project006.cpp ****     pr.conf    = conf;
 254:project006.cpp ****     pr.cents   = cents;
 255:project006.cpp ****     std::snprintf(pr.note, sizeof(pr.note), "%s", note);
 256:project006.cpp ****     return pr;
 257:project006.cpp **** }
