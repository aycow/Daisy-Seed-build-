 491:project006.cpp **** struct Debounce1
 492:project006.cpp **** {
 493:project006.cpp ****     bool     stable         = true; // pull-up: true=UP, false=DOWN
 494:project006.cpp ****     bool     last_sample    = true;
 495:project006.cpp ****     uint32_t last_change_ms = 0;
 496:project006.cpp **** 
 497:project006.cpp ****     bool Update(bool sample, uint32_t now_ms, uint32_t debounce_ms)
 498:project006.cpp ****     {
 499:project006.cpp ****         if(sample != last_sample)
 500:project006.cpp ****         {
 501:project006.cpp ****             last_sample    = sample;
 502:project006.cpp ****             last_change_ms = now_ms;
 503:project006.cpp ****         }
 504:project006.cpp ****         if(sample != stable && (now_ms - last_change_ms) >= debounce_ms)
 505:project006.cpp ****         {
 506:project006.cpp ****             stable = sample;
 507:project006.cpp ****             return true;
 508:project006.cpp ****         }
 509:project006.cpp ****         return false;
 510:project006.cpp ****     }
 511:project006.cpp **** };
