 264:project006.cpp **** 
 265:project006.cpp **** // Lightweight micro-granular (overlap-add pitch/time texture)
 266:project006.cpp **** // Inspired by a proven Daisy community implementation style:
 267:project006.cpp **** // - Two overlapping grains
 268:project006.cpp **** // - Taper window crossfade
 269:project006.cpp **** // - alpha < 1.0 keeps it stable/cheap
 270:project006.cpp **** struct MicroGranular
 271:project006.cpp **** {
 272:project006.cpp ****     static constexpr int   BUF_LEN     = 2048;
 273:project006.cpp ****     static constexpr int   TAPER_LEN   = 256;
 274:project006.cpp ****     static constexpr int   GRAIN_STRIDE = (BUF_LEN - TAPER_LEN); // 1792
 275:project006.cpp **** 
 276:project006.cpp ****     float buf[BUF_LEN];
 277:project006.cpp ****     float taper[TAPER_LEN];
 278:project006.cpp **** 
 279:project006.cpp ****     int  buf_index    = 0; // 0..GRAIN_STRIDE-1
 280:project006.cpp ****     int  write_count  = 0;
 281:project006.cpp ****     bool ready        = false;
 282:project006.cpp **** 
 283:project006.cpp ****     float alpha = 0.85f; // < 1.0 (stable)
 284:project006.cpp **** 
 285:project006.cpp ****     void Init()
 286:project006.cpp ****     {
 287:project006.cpp ****         std::memset(buf, 0, sizeof(buf));
 288:project006.cpp ****         // sine^2 ramp (0..1)
 289:project006.cpp ****         constexpr float kPI = 3.14159265358979323846f;
 290:project006.cpp ****         for(int i = 0; i < TAPER_LEN; i++)
 291:project006.cpp ****         {
 292:project006.cpp ****             float s = static_cast<float>(std::sin((float)i * (0.5f * kPI) / (float)TAPER_LEN));
 293:project006.cpp ****             taper[i] = s * s;
 294:project006.cpp ****         }
 295:project006.cpp ****         Reset();
 296:project006.cpp ****     }
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccFsimCz.s 			page 17


 297:project006.cpp **** 
 298:project006.cpp ****     void Reset()
 299:project006.cpp ****     {
 300:project006.cpp ****         buf_index   = 0;
 301:project006.cpp ****         write_count = 0;
 302:project006.cpp ****         ready       = false;
 303:project006.cpp ****         // keep buffer contents; or clear if you prefer:
 304:project006.cpp ****         // std::memset(buf, 0, sizeof(buf));
 305:project006.cpp ****     }
 306:project006.cpp **** 
 307:project006.cpp ****     inline void SetAlpha(float a)
 308:project006.cpp ****     {
 309:project006.cpp ****         // keep it safely < 1.0 so lerp never hits BUF_LEN-1 exactly
 310:project006.cpp ****         alpha = clampf(a, 0.55f, 0.99f);
 311:project006.cpp ****     }
 312:project006.cpp **** 
 313:project006.cpp ****     inline float Lerp(float index_f)
 314:project006.cpp ****     {
 315:project006.cpp ****         // index_f is expected in [0, BUF_LEN-2]
 316:project006.cpp ****         int   i    = (int)index_f;
 317:project006.cpp ****         float frac = index_f - (float)i;
 318:project006.cpp ****         float a    = buf[i];
 319:project006.cpp ****         float b    = buf[i + 1];
 320:project006.cpp ****         return a + frac * (b - a);
 321:project006.cpp ****     }
 322:project006.cpp **** 
 323:project006.cpp ****     inline void Write(float x)
 324:project006.cpp ****     {
 325:project006.cpp ****         buf[buf_index] = x;
 326:project006.cpp **** 
 327:project006.cpp ****         // mirror the taper region into the "previous grain" area
 328:project006.cpp ****         if(buf_index < TAPER_LEN)
 329:project006.cpp ****             buf[buf_index + GRAIN_STRIDE] = x;
 330:project006.cpp **** 
 331:project006.cpp ****         buf_index++;
 332:project006.cpp ****         if(buf_index >= GRAIN_STRIDE)
 333:project006.cpp ****             buf_index = 0;
 334:project006.cpp **** 
 335:project006.cpp ****         write_count++;
 336:project006.cpp ****         if(write_count >= BUF_LEN)
 337:project006.cpp ****             ready = true;
 338:project006.cpp ****     }
 339:project006.cpp **** 
 340:project006.cpp ****     inline float Process(float x, bool freeze)
 341:project006.cpp ****     {
 342:project006.cpp ****         if(!freeze)
 343:project006.cpp ****             Write(x);
 344:project006.cpp **** 
 345:project006.cpp ****         if(!ready)
 346:project006.cpp ****             return x; // until we’ve filled once, just pass-through
 347:project006.cpp **** 
 348:project006.cpp ****         // current grain (causal, because alpha<1)
 349:project006.cpp ****         float current = Lerp(alpha * (float)buf_index);
 350:project006.cpp ****         float out     = current;
 351:project006.cpp **** 
 352:project006.cpp ****         // crossfade in taper region with previous grain
 353:project006.cpp ****         if(buf_index < TAPER_LEN)
ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccFsimCz.s 			page 18


 354:project006.cpp ****         {
 355:project006.cpp ****             float prev = Lerp(alpha * (float)(buf_index + GRAIN_STRIDE));
 356:project006.cpp ****             float w    = taper[buf_index]; // 0..1
 357:project006.cpp ****             out        = w * current + (1.0f - w) * prev;
 358:project006.cpp ****         }
 359:project006.cpp **** 
 360:project006.cpp ****         return out;
 361:project006.cpp ****     }
 362:project006.cpp **** };
