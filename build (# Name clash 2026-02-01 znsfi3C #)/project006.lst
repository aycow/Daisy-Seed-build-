ARM GAS  C:\Users\aydan\AppData\Local\Temp\ccFsimCz.s 			page 14


 126:project006.cpp ****     if(pos >= 1 && pos <= 4)
 127:project006.cpp ****     {
 128:project006.cpp ****         out_fx = pos - 1;
