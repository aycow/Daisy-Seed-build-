 114:project006.cpp **** static int ReadRotaryRaw()
 115:project006.cpp **** {
 116:project006.cpp ****     // Inputs are pull-up: 1 = not selected, 0 = selected (grounded through common)
 117:project006.cpp ****     for(int i = 0; i < kNumPos; i++)
 118:project006.cpp ****         if(!rot[i].Read())
 119:project006.cpp ****             return i + 1; // 1..6
 120:project006.cpp ****     return 0; // can happen briefly while rotating
 121:project006.cpp **** }
