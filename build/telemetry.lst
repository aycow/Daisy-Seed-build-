 109:src/telemetry.cpp **** // Convert normalized pot values into the UART protocol range while clamping noise or bad inputs.
 110:src/telemetry.cpp **** int Telemetry::PotToU10k(float value)
 111:src/telemetry.cpp **** {
 112:src/telemetry.cpp ****     value = ClampFloat(value, 0.0f, 1.0f);
