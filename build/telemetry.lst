  36:src/telemetry.cpp **** // Pot telemetry uses integer 0..10000 scaling to avoid float formatting on the UART protocol.
  37:src/telemetry.cpp **** void Telemetry::SendPots(const float* pots)
  38:src/telemetry.cpp **** {
  39:src/telemetry.cpp ****     char buf[96];
  40:src/telemetry.cpp ****     std::snprintf(buf,
  41:src/telemetry.cpp ****                   sizeof(buf),
  42:src/telemetry.cpp ****                   "P,%d,%d,%d,%d\n",
  43:src/telemetry.cpp ****                   PotToU10k(pots[0]),
  44:src/telemetry.cpp ****                   PotToU10k(pots[1]),
  45:src/telemetry.cpp ****                   PotToU10k(pots[2]),
  46:src/telemetry.cpp ****                   PotToU10k(pots[3]));
  47:src/telemetry.cpp ****     Send(buf);
  48:src/telemetry.cpp **** }
  49:src/telemetry.cpp **** 
  50:src/telemetry.cpp **** // Footswitch telemetry reports both level and edge text so the Pi can update latch and event UI.
  51:src/telemetry.cpp **** void Telemetry::SendFootswitch(bool down, const char* edge, int press_count)
  52:src/telemetry.cpp **** {
  53:src/telemetry.cpp ****     char buf[96];
  54:src/telemetry.cpp ****     std::snprintf(buf, sizeof(buf), "S,%d,%s,%d\n", down ? 1 : 0, edge, press_count);
  55:src/telemetry.cpp ****     Send(buf);
  56:src/telemetry.cpp **** }
  57:src/telemetry.cpp **** 
  58:src/telemetry.cpp **** // Tuner telemetry preserves the production fields and scales frequency/cents/confidence as integer
  59:src/telemetry.cpp **** void Telemetry::SendTuner(const TunerResult& result)
  60:src/telemetry.cpp **** {
  61:src/telemetry.cpp ****     const float freq_hz = result.freq_hz < 0.0f ? 0.0f : result.freq_hz;
  62:src/telemetry.cpp ****     const int freq_mhz = (int)(freq_hz * 1000.0f + 0.5f);
  63:src/telemetry.cpp ****     const float cents_scaled = result.cents * 100.0f;
  64:src/telemetry.cpp ****     const int cents_c = (int)(cents_scaled + (cents_scaled >= 0.0f ? 0.5f : -0.5f));
  65:src/telemetry.cpp ****     const int conf_m = (int)(ClampFloat(result.confidence, 0.0f, 1.0f) * 1000.0f + 0.5f);
  66:src/telemetry.cpp **** 
  67:src/telemetry.cpp ****     char buf[128];
  68:src/telemetry.cpp ****     std::snprintf(buf,
  69:src/telemetry.cpp ****                   sizeof(buf),
  70:src/telemetry.cpp ****                   "T,%d,%d,%s,%d,%d\n",
  71:src/telemetry.cpp ****                   result.valid ? 1 : 0,
  72:src/telemetry.cpp ****                   freq_mhz,
  73:src/telemetry.cpp ****                   result.note,
  74:src/telemetry.cpp ****                   cents_c,
  75:src/telemetry.cpp ****                   conf_m);
  76:src/telemetry.cpp ****     Send(buf);
  77:src/telemetry.cpp **** }
