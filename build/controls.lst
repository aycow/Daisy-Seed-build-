  11:src/controls.h **** 
  12:src/controls.h **** // One debounced footswitch transition. The controls code returns this to the
  13:src/controls.h **** // foreground loop so telemetry can report press/release edges without involving
  14:src/controls.h **** // the audio callback.
  15:src/controls.h **** struct FootswitchEvent
  16:src/controls.h **** {
  17:src/controls.h ****     bool occurred;
  18:src/controls.h ****     bool down;
  19:src/controls.h ****     const char* edge;
  20:src/controls.h ****     int press_count;
  21:src/controls.h **** };
  22:src/controls.h **** 
  23:src/controls.h **** // Small wrap-safe boolean debouncer for a single GPIO input. Update() returns
  24:src/controls.h **** // true only when the stable output changes after the configured quiet interval.
  25:src/controls.h **** class DebounceBool
  26:src/controls.h **** {
  27:src/controls.h ****   public:
  28:src/controls.h ****     DebounceBool();
  29:src/controls.h ****     bool Update(bool sample, uint32_t now_ms, uint32_t debounce_ms);
  30:src/controls.h ****     bool stable() const { return stable_; }
  31:src/controls.h **** 
  32:src/controls.h ****   private:
  33:src/controls.h ****     bool stable_;
  34:src/controls.h ****     bool last_sample_;
  35:src/controls.h ****     uint32_t last_change_ms_;
  36:src/controls.h **** };
  37:src/controls.h **** 
  38:src/controls.h **** // Decoder for the six-position resistor-ladder rotary switch. It accepts raw
  39:src/controls.h **** // 16-bit ADC values, supports ascending or descending calibration centers, and
  40:src/controls.h **** // returns position 0 while the input is between detents or too far from a center.
  41:src/controls.h **** class AnalogRotaryLadder
  42:src/controls.h **** {
  43:src/controls.h ****   public:
  44:src/controls.h ****     AnalogRotaryLadder();
  45:src/controls.h **** 
  46:src/controls.h ****     // centers are in logical throw order, not necessarily voltage order. Init()
  47:src/controls.h ****     // validates strict monotonicity and precomputes midpoint thresholds.
  48:src/controls.h ****     bool Init(const uint16_t* centers, int count, uint16_t hysteresis, uint16_t max_center_error);
  49:src/controls.h **** 
  50:src/controls.h ****     // Decode() is immediate and stateless except for hysteresis around the current
  51:src/controls.h ****     // stable position. Update() adds time-based debounce before changing output.
  52:src/controls.h ****     int Decode(uint16_t value_u16) const;
  53:src/controls.h ****     int Update(uint16_t value_u16, uint32_t now_ms);
  54:src/controls.h ****     int stable_position() const { return stable_position_; }
