 176:src/controls.cpp ****     float rotary_accum = 0.0f;
 177:src/controls.cpp ****     constexpr int kPrimeSamples = 8;
 178:src/controls.cpp ****     for(int sample = 0; sample < kPrimeSamples; ++sample)
 179:src/controls.cpp ****     {
 180:src/controls.cpp ****         for(int i = 0; i < config::kPhysicalPotCount; ++i)
 181:src/controls.cpp ****             pot_accum[i] += ClampFloat(hw.adc.GetFloat(i), 0.0f, 1.0f);
 182:src/controls.cpp ****         rotary_accum += ClampFloat(hw.adc.GetFloat(config::ADC_ROTARY), 0.0f, 1.0f);
 183:src/controls.cpp ****         hw.DelayMs(1);
 184:src/controls.cpp ****     }
 185:src/controls.cpp **** 
 186:src/controls.cpp ****     for(int i = 0; i < config::kPhysicalPotCount; ++i)
 187:src/controls.cpp ****     {
 188:src/controls.cpp ****         pot_filtered_[i] = pot_accum[i] / (float)kPrimeSamples;
 189:src/controls.cpp ****         pot_fixed_[i] = FloatToU16(pot_filtered_[i]);
