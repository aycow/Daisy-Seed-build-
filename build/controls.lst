   5:src/controls.cpp **** 
   6:src/controls.cpp **** // Keep ADC-derived values inside the normalized range expected by smoothing and telemetry.
   7:src/controls.cpp **** static float ClampFloat(float value, float lo, float hi)
   8:src/controls.cpp **** {
   9:src/controls.cpp ****     return value < lo ? lo : (value > hi ? hi : value);
