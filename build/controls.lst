 167:src/controls.cpp ****     hw.DelayMs(5);
 168:src/controls.cpp **** 
 169:src/controls.cpp ****     foot_.Init(config::kFootswitchPin, daisy::GPIO::Mode::INPUT, daisy::GPIO::Pull::PULLUP);
 170:src/controls.cpp ****     const bool rotary_ok = rotary_.Init(config::kRotaryCentersU16,
 171:src/controls.cpp ****                                         config::kRotaryPositionCount,
 172:src/controls.cpp ****                                         config::kRotaryHysteresisU16,
 173:src/controls.cpp ****                                         config::kRotaryMaxCenterErrorU16);
 174:src/controls.cpp **** 
