 197:src/controls.cpp ****         const int stable = rotary_.Update(rotary_raw, now + config::kRotaryDebounceMs);
 198:src/controls.cpp ****         uint8_t mapped_effect = requested_effect_;
 199:src/controls.cpp ****         if(RotaryPositionToEffect(stable != 0 ? stable : first, mapped_effect))
 200:src/controls.cpp ****             requested_effect_ = mapped_effect;
