  17:src/controls.cpp **** // Timer math casts the subtraction to uint32_t so debounce still works when the millisecond counte
  18:src/controls.cpp **** bool DebounceBool::Update(bool sample, uint32_t now_ms, uint32_t debounce_ms)
  19:src/controls.cpp **** {
  20:src/controls.cpp ****     if(sample != last_sample_)
  21:src/controls.cpp ****     {
  22:src/controls.cpp ****         last_sample_ = sample;
  23:src/controls.cpp ****         last_change_ms_ = now_ms;
  24:src/controls.cpp ****     }
  25:src/controls.cpp **** 
  26:src/controls.cpp ****     if(sample != stable_ && (uint32_t)(now_ms - last_change_ms_) >= debounce_ms)
  27:src/controls.cpp ****     {
  28:src/controls.cpp ****         stable_ = sample;
  29:src/controls.cpp ****         return true;
  30:src/controls.cpp ****     }
