 155:src/controls.cpp **** // real readings before publishing the first control snapshot.
 156:src/controls.cpp **** void Controls::Init(daisy::DaisySeed& hw, ControlMailbox& mailbox)
 157:src/controls.cpp **** {
 158:src/controls.cpp ****     mailbox_ = &mailbox;
 159:src/controls.cpp **** 
 160:src/controls.cpp ****     daisy::AdcChannelConfig adc_cfg[config::ADC_COUNT];
 161:src/controls.cpp ****     adc_cfg[config::ADC_POT_0].InitSingle(config::kPotPins[0]);
 162:src/controls.cpp ****     adc_cfg[config::ADC_POT_1].InitSingle(config::kPotPins[1]);
 163:src/controls.cpp ****     adc_cfg[config::ADC_POT_2].InitSingle(config::kPotPins[2]);
 164:src/controls.cpp ****     adc_cfg[config::ADC_ROTARY].InitSingle(config::kRotaryPin);
 165:src/controls.cpp ****     hw.adc.Init(adc_cfg, config::ADC_COUNT);
