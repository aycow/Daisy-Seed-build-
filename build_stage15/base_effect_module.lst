 149:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** {
 150:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     int binCount = GetParameterBinCount(parameter_id);
 151:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 152:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     // Make this is a binned value
 153:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     if (binCount == -1)
 154:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     {
 155:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****         return 1;
 156:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     }
 157:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 158:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     // Get the Bin number from a raw value stored as 0..127
 159:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     float binSize = 128.0f / binCount;
 160:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     float midPoint = (0.5f - (1.0f / 128.0f));
 161:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     float offset = (1.0f / 128.0f);
 162:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 163:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     // Calculate the bin
 164:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     int bin = (int)(((GetParameterRaw(parameter_id) + midPoint) / binSize) + offset) + 1;
 165:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 166:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     // A little sanity checking, make sure the bin is clamped to 1..BinCount
 167:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     if (bin < 1)
 168:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     {
 169:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****         bin = 1;
 170:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     }
 171:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 172:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     if (bin > binCount)
 173:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     {
 174:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****         bin = binCount;
 175:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     }
 176:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp **** 
 177:gml/GuitarPedal/Effect-Modules/base_effect_module.cpp ****     return bin;
