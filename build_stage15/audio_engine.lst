  67:src/control_mailbox.h ****     snapshot_ = snapshot;
  68:src/control_mailbox.h ****     __atomic_store_n(&sequence_, (start + 2u) & ~1u, __ATOMIC_RELEASE);
  69:src/control_mailbox.h **** }
